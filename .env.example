# ==============================================================================
# ROYALS INTELLIGENCE - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local orchestration with Docker Compose
# ==============================================================================

# Project Details
PROJECT_NAME="Royals Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars

# PostgreSQL Database Configuration
POSTGRES_USER=royals_admin
POSTGRES_PASSWORD=royals_secure_dev_password
POSTGRES_DB=royals_intelligence_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://royals_admin:royals_secure_dev_password@localhost:5432/royals_intelligence_db

# Redis & Celery Cache / Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="Royals Intelligence"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# Data Classification & Access Control
DATA_STORAGE_PATH=./data
PROPRIETARY_DATA_ACCESS=false
