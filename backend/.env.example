# ==============================================================================
# ROYALS INTELLIGENCE - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# General
PROJECT_NAME="Royals Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars

# Server
HOST=0.0.0.0
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (AsyncPG)
POSTGRES_USER=royals_admin
POSTGRES_PASSWORD=royals_secure_dev_password
POSTGRES_DB=royals_intelligence_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://royals_admin:royals_secure_dev_password@localhost:5432/royals_intelligence_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Data Storage
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
DATA_EXTERNAL_DIR=../data/external
