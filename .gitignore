# ==============================================================================
# Royals Intelligence - Monorepo .gitignore
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit credentials or secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
frontend/node_modules/
node_modules/
.pnp
.pnp.js
frontend/.next/
.next/
frontend/out/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo
*.tsbuildinfo

# Data and Proprietary Assets Isolation
# Note: Keep directories via .gitkeep but ignore heavy and proprietary datasets
data/raw/**/*
!data/raw/**/.gitkeep
!data/raw/**/
data/processed/**/*
!data/processed/**/.gitkeep
!data/processed/**/
data/external/**/*
!data/external/**/.gitkeep
!data/external/**/
data/proprietary/**/*
!data/proprietary/**/.gitkeep
!data/proprietary/**/
round1_pressure/data/raw/**/*
!round1_pressure/data/raw/**/.gitkeep
!round1_pressure/data/raw/**/
round1_pressure/data/processed/**/*
!round1_pressure/data/processed/**/.gitkeep
!round1_pressure/data/processed/**/
round1_pressure/data/outputs/**/*
!round1_pressure/data/outputs/**/.gitkeep
!round1_pressure/data/outputs/**/

# Generated Reports & Exports
reports/generated/*
!reports/generated/.gitkeep

# Database & Cache Local Mounts
*.sqlite3
*.db
pgdata/
redisdata/

# OS and Editor Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
